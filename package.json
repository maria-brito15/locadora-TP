{
  "name": "locadora",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install",
    "check": "tsc --noEmit",
    "lint": "eslint src frontend/src e2e playwright.config.ts",
    "lint:fix": "eslint src frontend/src e2e playwright.config.ts --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write src frontend/src e2e playwright.config.ts",
    "format:check": "prettier --check src frontend/src e2e playwright.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^2.12.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
